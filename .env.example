# ==============================================================================
# AVENORA Environment Configuration Template
# ==============================================================================
# Notice: All external services (Supabase, Google Gemini) are completely optional.
# If these variables are not provided, AVENORA runs in a fully functional client/server
# demonstration mode with local persistence and rule-based AI matching against real data.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database Persistence (Optional)
# ------------------------------------------------------------------------------
# Used to persist client acquisition inquiries and viewing bookings to a PostgreSQL database.
# If omitted, submissions are stored in client localStorage with honest demo receipts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Server-Side AI Consultant Model (Optional)
# ------------------------------------------------------------------------------
# Used by the /api/chat route handler for generative AI conversation.
# If omitted, AVENORA activates its built-in rule-based NLP matcher against the real dataset.
# Keep these secrets strictly on the server; NEVER prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
